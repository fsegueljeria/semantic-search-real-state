# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=real_estate_properties
QDRANT_COLLECTION_ALIAS=real_estate_properties_current
QDRANT_COLLECTION_VERSION_SUFFIX=v2

# ETL Configuration
BATCH_SIZE=500
MAX_WORKERS=4
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-es
EMBEDDING_DIMENSION=768

# Search pipeline
TOP_K_FINAL=5
TOP_K_RETRIEVAL=100
SCORE_THRESHOLD=0.0
ENABLE_TWO_STAGE_RANKING=true
ENABLE_CROSS_ENCODER_RERANK=false
ENABLE_SPARSE_DENSE_HYBRID=true
HYBRID_ALPHA=0.7
SPARSE_HASH_SPACE=1048576
SPARSE_MIN_TOKEN_LENGTH=3

# ETL derived metadata enrichment
ENABLE_LLM_BATCH_ENRICHMENT=false
LLM_ENRICHMENT_PROVIDER=openai
LLM_ENRICHMENT_MODEL=gpt-4o-mini
LLM_ENRICHMENT_API_KEY=

# Telemetry
ENABLE_QUERY_TELEMETRY=true

# Data Sources
CSV_FILE_PATH=./lyon_balmaceda_scraper.csv

# Logging
LOG_LEVEL=INFO